{
  "schemaVersion": 1,
  "id": "local.file-review",
  "name": "整会话文件审查",
  "description": "在原生按轮审查之外，按文件汇总整个会话的修改记录并提示缺失证据。",
  "version": "0.2.0",
  "main": "main.cjs",
  "engines": { "piDesktop": ">=2610.1910.4814" },
  "permissions": ["ui.view", "desktop.control"],
  "activationEvents": ["onStartup", "onCommand:file-review.open"],
  "contributes": {
    "views": [{
      "id": "review",
      "title": { "zh-CN": "整会话文件审查", "en": "Session file review" },
      "icon": "diff",
      "entry": "view/index.html",
      "order": 30
    }],
    "commands": [{
      "id": "file-review.open",
      "title": "整会话文件审查 / Session file review",
      "keywords": ["审查", "文件", "差异", "撤销", "review", "diff", "rollback"]
    }]
  }
}
