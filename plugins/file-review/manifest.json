{
  "schemaVersion": 1,
  "id": "local.file-review",
  "name": "任务文件审查增强",
  "description": "在原生审查之上提供按文件分组与本轮／整会话筛选。",
  "version": "0.1.2",
  "main": "main.cjs",
  "renderer": "renderer/index.mjs",
  "rendererActions": ["plugin.call"],
  "rendererCallMethods": ["review.summary", "review.open"],
  "engines": { "piDesktop": ">=2610.1910.4814" },
  "permissions": ["ui.view", "renderer.extension", "desktop.control"],
  "activationEvents": ["onStartup", "onCommand:file-review.open"],
  "contributes": {
    "views": [{
      "id": "review",
      "title": { "zh-CN": "任务文件审查增强", "en": "Task review enhancements" },
      "icon": "diff",
      "entry": "view/index.html",
      "order": 30
    }],
    "commands": [{
      "id": "file-review.open",
      "title": "任务文件审查增强 / Task review enhancements",
      "keywords": ["审查", "文件", "差异", "撤销", "review", "diff", "rollback"]
    }]
  }
}
