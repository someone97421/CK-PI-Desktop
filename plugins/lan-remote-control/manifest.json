{
  "schemaVersion": 1,
  "id": "local.lan-remote-control",
  "name": "局域网远程控制",
  "description": "通过局域网浏览器或 Chrome 侧边栏访问这是一个助手的项目和会话，并连接 Browse 浏览器调试。共用访问密码和设备记录；默认不监听网络。",
  "version": "0.2.41",
  "main": "main.cjs",
  "enabledByDefault": false,
  "engines": {
    "piDesktop": ">=2609.1622.5115"
  },
  "permissions": [
    "ui.panel",
    "background.service",
    "desktop.control",
    "models.list",
    "mcp.server.local",
    "clipboard.write"
  ],
  "activationEvents": [
    "onStartup",
    "onCommand:lan-remote-control.open"
  ],
  "ui": {
    "panel": "panel/index.html",
    "width": 840,
    "height": 760,
    "title": "局域网远程控制"
  },
  "contributes": {
    "mcpServers": [
      {
        "id": "browse",
        "label": "Browse 浏览器调试",
        "transport": "stdio",
        "command": "browse",
        "args": [
          "mcp"
        ],
        "env": {
          "OPENCODE_BROWSER_TOOLS": "all",
          "OPENCODE_BROWSER_PORT": "19988"
        }
      }
    ],
    "commands": [
      {
        "id": "lan-remote-control.open",
        "title": "局域网远程控制",
        "keywords": [
          "手机",
          "远程",
          "局域网",
          "remote",
          "LAN",
          "Chrome",
          "侧边栏",
          "Browse",
          "浏览器调试"
        ],
        "category": "远程访问"
      }
    ],
    "services": [
      {
        "id": "lan-remote-control",
        "label": "局域网远程控制",
        "autoRestart": true
      }
    ],
    "settingsDestinations": [
      {
        "id": "lan-remote-control",
        "label": "局域网远程控制",
        "icon": "plug",
        "keywords": [
          "局域网",
          "手机",
          "密码",
          "远程",
          "Chrome",
          "侧边栏",
          "Browse"
        ],
        "entry": "panel/index.html"
      }
    ]
  }
}
