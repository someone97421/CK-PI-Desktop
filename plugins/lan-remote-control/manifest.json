{
  "schemaVersion": 1,
  "id": "local.lan-remote-control",
  "name": "局域网远控 V2",
  "description": "直接投射当前安装的原版 Renderer，仅转换局域网通信、认证、IPC 与资源。保存访问密码和自动启用选择。",
  "version": "2.0.10",
  "main": "main.cjs",
  "enabledByDefault": false,
  "engines": {
    "piDesktop": ">=2609.1622.5115"
  },
  "permissions": [
    "ui.panel",
    "background.service",
    "desktop.control",
    "mcp.server.local"
  ],
  "activationEvents": [
    "onStartup",
    "onCommand:lan-remote-control.open"
  ],
  "ui": {
    "panel": "settings/index.html",
    "width": 700,
    "height": 560,
    "title": "局域网远控 V2"
  },
  "contributes": {
    "mcpServers": [
      {
        "id": "browse",
        "label": "Browse 浏览器调试",
        "transport": "stdio",
        "command": "browse",
        "args": [
          "mcp"
        ],
        "env": {
          "OPENCODE_BROWSER_TOOLS": "all",
          "OPENCODE_BROWSER_PORT": "19988"
        }
      }
    ],
    "commands": [
      {
        "id": "lan-remote-control.open",
        "title": "局域网远控 V2",
        "keywords": [
          "手机",
          "远程",
          "局域网",
          "remote",
          "LAN",
          "Chrome",
          "侧边栏",
          "Browse",
          "浏览器调试"
        ],
        "category": "远程访问"
      }
    ],
    "services": [
      {
        "id": "lan-remote-control",
        "label": "局域网远控 V2",
        "autoRestart": true
      }
    ],
    "settingsDestinations": [
      {
        "id": "lan-remote-control",
        "label": "局域网远控 V2",
        "icon": "plug",
        "keywords": [
          "局域网",
          "手机",
          "密码",
          "远程",
          "Chrome",
          "侧边栏",
          "Browse"
        ],
        "entry": "settings/index.html"
      }
    ]
  }
}
