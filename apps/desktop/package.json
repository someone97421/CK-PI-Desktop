{
  "name": "@pi-desktop/desktop",
  "version": "2609.2416.5149",
  "desktopName": "this-is-a-agent.desktop",
  "private": true,
  "description": "这是一个助手 — local-first AI coding agent desktop app",
  "homepage": "https://github.com/someone97421/CK-PI-Desktop",
  "author": {
    "name": "someone97421"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter \"@pi-desktop/desktop^...\" build",
    "dev": "node ../../scripts/build.mjs dev",
    "build": "node ../../scripts/build.mjs desktop",
    "preview": "electron-vite preview",
    "postinstall": "node ../../scripts/ensure-electron.mjs && electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint": "node ../../scripts/check-style-tokens.mjs",
    "clean": "node -e \"fs.rmSync('out',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true})\"",
    "build:host-release": "node ../../scripts/build.mjs host",
    "bundle:runtime": "node ../../scripts/build.mjs runtime",
    "pack": "node ../../scripts/build.mjs pack",
    "dist": "node ../../scripts/build.mjs dist",
    "dist:mac": "node ../../scripts/build.mjs dist:mac",
    "dist:win": "node ../../scripts/build.mjs dist:win",
    "dist:linux": "node ../../scripts/build.mjs dist:linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@pi-desktop/agent-host": "workspace:*",
    "@pi-desktop/agent-runtime": "workspace:*",
    "@pi-desktop/host-runtime": "workspace:*",
    "@pi-desktop/i18n": "workspace:*",
    "@pi-desktop/plugin-devkit": "workspace:*",
    "@pi-desktop/plugin-sdk": "workspace:*",
    "@pi-desktop/racp": "workspace:*",
    "@pi-desktop/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "dompurify": "^3.4.13",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "i18next": "^26.3.6",
    "katex": "^0.16.47",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "pinyin-pro": "3.29.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.6.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.6",
    "ws": "8.21.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.someone97421.this-is-a-agent",
    "productName": "this-is-a-agent",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "someone97421",
        "repo": "CK-PI-Desktop"
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/*/{test,tests,__tests__,powered-test,example,examples}/**",
      "!**/node_modules/**/*.{test,spec}.{js,cjs,mjs}",
      "!**/node_modules/node-addon-api/tools/**",
      "!**/node_modules/node-addon-api/*.{c,gyp,gypi,h,js,json}",
      "!**/node_modules/node-addon-api/README.md"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "../../packages/agent-runtime/dist-bundle",
        "to": "agent-runtime"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/plugins",
        "to": "plugins"
      },
      {
        "from": "resources/models.dev",
        "to": "models.dev"
      }
    ],
    "mac": {
      "identity": "-",
      "artifactName": "this-is-a-agent-20260924-165149-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "this-is-a-agent needs local network access so agents can reach OpenAI-compatible providers, Ollama, and other AI endpoints running on your LAN. / 这是一个助手需要本地网络访问权限，以便助手请求同一局域网中的 OpenAI 兼容服务、Ollama 等本地 AI 端点。",
        "NSMicrophoneUsageDescription": "this-is-a-agent plugins may use the microphone after you grant them audio access. / 在你授权后，这是一个助手的插件可以使用麦克风。",
        "NSBonjourServices": [
          "_http._tcp",
          "_https._tcp"
        ],
        "CFBundleDisplayName": "这是一个助手",
        "CFBundleName": "this-is-a-agent"
      },
      "extraResources": [
        {
          "from": "../../target/release/pi-desktop-host-core",
          "to": "bin/pi-desktop-host-core"
        },
        {
          "from": "build/tray-icon-mac.png",
          "to": "tray-icon-mac.png"
        }
      ],
      "extraDistFiles": [
        "this-is-a-agent-macOS-open.command",
        "this-is-a-agent-macOS-opening-help.txt"
      ],
      "bundleVersion": "2609.2416.5149"
    },
    "dmg": {
      "artifactName": "this-is-a-agent-20260924-165149-${arch}.${ext}",
      "window": {
        "width": 720,
        "height": 500
      },
      "iconSize": 96,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 180,
          "y": 240
        },
        {
          "x": 540,
          "y": 240,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 470,
          "y": 370,
          "type": "file",
          "name": "If app won't open, read this.txt",
          "path": "this-is-a-agent-macOS-opening-help.txt"
        }
      ],
      "backgroundColor": "#292929"
    },
    "win": {
      "executableName": "this-is-a-agent",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "../../target/release/pi-desktop-host-core.exe",
          "to": "bin/pi-desktop-host-core.exe"
        },
        {
          "from": "build/icon.ico",
          "to": "app-icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "这是一个助手",
      "artifactName": "this-is-a-agent-Setup-20260924-165149-${arch}.${ext}",
      "uninstallDisplayName": "这是一个助手",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "this-is-a-agent-Portable-20260924-165149-${arch}.${ext}",
      "requestExecutionLevel": "user",
      "unpackDirName": "this-is-a-agent-Portable"
    },
    "deb": {
      "packageName": "this-is-a-agent",
      "artifactName": "this-is-a-agent-20260924-165149-${arch}.${ext}"
    },
    "rpm": {
      "packageName": "this-is-a-agent",
      "artifactName": "this-is-a-agent-20260924-165149-${arch}.${ext}",
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "linux": {
      "executableName": "this-is-a-agent",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "../../target/release/pi-desktop-host-core",
          "to": "bin/pi-desktop-host-core"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "这是一个助手",
          "Name[en]": "this-is-a-agent",
          "Comment": "这是一个助手"
        }
      },
      "artifactName": "this-is-a-agent-20260924-165149-${arch}.${ext}"
    },
    "asar": {
      "smartUnpack": false
    },
    "buildVersion": "2609.2416.5149.0",
    "extraMetadata": {
      "name": "this-is-a-agent"
    }
  },
  "buildVersionLabel": "20260924-165149"
}
